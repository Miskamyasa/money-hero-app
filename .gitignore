# Deny-by-default strategy: everything is ignored, then explicit allowlist
# entries un-ignore tracked content. Each project subdirectory has its own
# .gitignore that follows the same pattern. Adding a new top-level file or
# directory requires adding an explicit "!name" rule below.

*

!.gitignore
!README.md
!LICENSE

# Tool versions for mise (managed at the repo root)
!mise.toml

# Development container definition (used by VS Code / opencode devcontainer)
!.devcontainer/
!.devcontainer/devcontainer.json

# Project specifications and architecture documentation
!docs/
!docs/*.md

# Monorepo project directories. Each owns its own .gitignore.
!api/
!admin/
!app/
!swift/

# Assets directory for static files, images, etc.
!assets/
!assets/**

# Top-level guide read by every AI agent at task start
!AGENTS.md

# Screenshots directory for visual communication with Agents
!screenshots/
!screenshots/**
